PORT=8080
GITHUB_TOKEN=
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_MINUTES=60
CORS_ALLOW_ORIGIN=*

# Analysis Limits
MAX_FILES_FOR_AUTHOR_ANALYSIS=1024

# HTTP Server Timeouts (in seconds) - Important for large repositories
# HTTP_READ_TIMEOUT_SECONDS=300    # 5 minutes (default)
# HTTP_WRITE_TIMEOUT_SECONDS=600   # 10 minutes (default)
# HTTP_IDLE_TIMEOUT_SECONDS=120    # 2 minutes (default)
